<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.GlobalPaymentsSample" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/gp_primary</item>
        <item name="colorPrimaryVariant">@color/gp_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/gp_secondary</item>
        <item name="colorSecondaryVariant">@color/gp_secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
    
    <!-- Card style for payment form -->
    <style name="CardStyle">
        <item name="android:layout_margin">16dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:background">@drawable/card_background</item>
    </style>
    
    <!-- Input field style -->
    <style name="InputFieldStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    
    <!-- Button style -->
    <style name="PrimaryButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>